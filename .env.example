# NVIDIA NIM API key for the portfolio chat agent (free tier, no card required)
# Get yours at https://build.nvidia.com
NVIDIA_API_KEY=
# Optional: override the default Nemotron model (see build.nvidia.com for available model IDs)
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL
NEXT_PUBLIC_SITE_URL=https://gabrielpitrella.com

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
